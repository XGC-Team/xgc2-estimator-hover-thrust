include("${CMAKE_CURRENT_LIST_DIR}/HoverThrustEstimatorTargets.cmake")
set_property(TARGET HoverThrustEstimator::Runtime APPEND PROPERTY
  INTERFACE_INCLUDE_DIRECTORIES "${XGC2_STATE_MACHINE_INCLUDE_DIRS}")
